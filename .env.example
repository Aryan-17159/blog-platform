# Rename this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/blogplatform?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Port the server listens on
PORT=3000
